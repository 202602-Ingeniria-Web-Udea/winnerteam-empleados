# Conexión que usa la aplicación en tiempo de ejecución.
# En Supabase: "Connection pooling" → Transaction pooler (puerto 6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/empleados"

# Conexión directa que usa la CLI de Prisma para migraciones.
# En Supabase: "Direct connection" o Session pooler (puerto 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/empleados"

# Clave para firmar el JWT de sesión. Generar con: openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-una-clave-aleatoria-de-32-caracteres"
