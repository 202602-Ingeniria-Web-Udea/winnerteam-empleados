// Esquema del Sistema de Gestión de Empleados (banco de horas).
// Mapeo con el enunciado: Maestro = Employee, Movimiento = HourMovement,
// Saldo = horas acumuladas del empleado.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Enum_Role {
  ADMIN
  USER
}

// ENTRADA suma horas (jornada, horas extra); SALIDA las descuenta (ausencias, permisos).
enum Enum_MovementType {
  ENTRADA
  SALIDA
}

// Motivo que justifica cada movimiento (etiquetas en lib/reasons.ts).
enum Enum_MovementReason {
  HORAS_EXTRA
  TURNO_SABADO
  FESTIVO_TRABAJADO
  PERMISO
  CITA_MEDICA
  DIA_COMPENSATORIO
  SALDO_INICIAL
  OTRO
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  lastName         String?
  // Hash bcrypt, nunca la contraseña en texto plano.
  password         String
  deleted          Boolean        @default(false)
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  role             Enum_Role      @default(USER)
  profile          Profile?
  employeesCreated Employee[]
  movementsCreated HourMovement[]
}

model Profile {
  id        String   @id @default(cuid())
  address   String
  phone     String
  // URL de la foto que se muestra en el sidebar.
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
}

model Employee {
  id          String         @id @default(cuid())
  name        String
  // Nombre en minúsculas y sin tildes (normalizeSearch) para buscar "rios" y encontrar "Ríos".
  nameSearch  String         @default("")
  // Saldo en horas. Es una caché de la suma de movimientos y se actualiza
  // en la misma transacción que crea cada movimiento.
  balance     Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdById String
  movements   HourMovement[]
}

model HourMovement {
  id          String              @id @default(cuid())
  type        Enum_MovementType
  // Horas enteras, siempre positivas; el signo lo da `type`.
  quantity    Int
  // Justificación obligatoria del movimiento (la API valida que el motivo
  // corresponda al tipo). Los valores por defecto solo cubren filas antiguas.
  reason      Enum_MovementReason @default(OTRO)
  description String              @default("")
  createdAt   DateTime            @default(now())
  employee    Employee            @relation(fields: [employeeId], references: [id])
  employeeId  String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdById String

  @@index([employeeId, createdAt])
}

// Solicitudes "Hablar con ventas" enviadas desde la landing.
model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  company   String
  email     String
  teamSize  String
  plan      String
  message   String?
  createdAt DateTime @default(now())
}
